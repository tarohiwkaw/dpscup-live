{
  "rules": {
    "dpscup-2-scores": {
      ".read": true,
      ".write": "auth != null"
    },
    "dpscup-2-summary": {
      ".read": true,
      ".write": "auth != null"
    },
    "dpscup-2-reports": {
      ".read": "auth != null",
      ".write": "auth != null || !data.exists()",
      ".indexOn": [
        "createdAt"
      ]
    },
    "dpscup-bracket": {
      ".read": true,
      ".write": "auth != null"
    },
    "dpscup-2-schedule": {
      ".read": true,
      ".write": "auth != null"
    }
  }
}